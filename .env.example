# Solo laboratorio local. Cambia estos valores si reutilizas la configuración fuera de la demo.
POSTGRES_DB=honeyphone
POSTGRES_USER=honeyphone_dev
POSTGRES_PASSWORD=honeyphone_local_only
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://honeyphone_dev:honeyphone_local_only@127.0.0.1:5433/honeyphone
APP_ENV=local
MAX_BODY_BYTES=65536
# Vacío significa que las sondas del proyecto siguen no configuradas.
PROBE_DNS_NAME=
PROBE_HTTPS_URL=
